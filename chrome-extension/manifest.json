{
  "manifest_version": 3,
  "name": "Multilingual Translator",
  "version": "1.0.0",
  "description": "Translate selected webpage text into Moroccan Darija or Hindi.",

  "minimum_chrome_version": "116",

  "permissions": [
    "sidePanel",
    "storage"
  ],

  "host_permissions": [
    "http://localhost:8080/*",
    "http://*/*",
    "https://*/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Open Multilingual Translator"
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}